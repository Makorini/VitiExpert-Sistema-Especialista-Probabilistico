# Copie este arquivo para ".env" (na pasta VitiExpert) e preencha.
# O arquivo .env NÃO vai para o git (.gitignore).

# ------------------------------------------------------------------
# ENVIO DO CÓDIGO DE CONFIRMAÇÃO (escolha UMA das formas)
# ------------------------------------------------------------------

# Forma 1 (recomendada, igual ao projeto do salão): Google Apps Script
# na conta makorini.dev@gmail.com. Não precisa de senha de app.
# Passo a passo: docs/enviar_email_apps_script.gs e README.
MAIL_SCRIPT_URL=
MAIL_SCRIPT_TOKEN=

# Forma 2 (alternativa): SMTP do Gmail com "senha de app" de 16 letras.
# MAIL_USERNAME=makorini.dev@gmail.com
# MAIL_PASSWORD=

# Nome que aparece como remetente (opcional, padrão: VitiExpert).
# MAIL_FROM_NAME=VitiExpert

# Opcional: chave secreta fixa (senão é gerada em instance/secret_key).
# SECRET_KEY=
